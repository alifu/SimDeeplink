{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimDeeplink",
  "version": "0.0.6",
  "identifier": "com.alifu.SimDeeplink",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": false,
        "title": "SimDeeplink",
        "width": 600,
        "height": 500,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis",
      "msi",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "public.app-category.developer-tools",
    "longDescription": "SimDeeplink is a tray app that opens deeplinks on iOS simulators (macOS) and Android emulators (macOS, Windows, Linux).",
    "shortDescription": "Run deeplinks on iOS simulators and Android emulators",
    "publisher": "alifu",
    "homepage": "https://github.com/alifu/SimDeeplink",
    "license": "MIT",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3"
        ]
      }
    }
  }
}
